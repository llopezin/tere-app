# e2e stack only (Playwright boots the backend with this env). Own database and ports, so it never
# touches the dev DB (fisio_app, :3000) or the Vitest DB (fisio_app_test). Test-only values.
DATABASE_URL=postgres://user:password@localhost:5432/fisio_app_e2e
BETTER_AUTH_SECRET=test-secret-key-at-least-32-characters-long
BETTER_AUTH_URL=http://localhost:3100
PORT=3100
NODE_ENV=test
CLIENT_APP_URL=http://localhost:5175
# The backend also loads apps/backend/.env for unset variables: keep a dev calendar sync out of e2e
GCAL_SYNC_ENABLED=false
